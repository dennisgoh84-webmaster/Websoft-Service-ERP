APP_NAME="Websoft Service ERP Solution"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Singapore
APP_URL=http://localhost:8001

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=websoft_php_erp
DB_USERNAME=websoft_app
DB_PASSWORD=websoft_dev_local

# Stateless JWT auth (mirrors backend/app/core/deps.py) -- no server-side
# session tied to a single connection, so any number of staff can be
# signed in and working at once. No PHP session storage is needed.
SESSION_DRIVER=array

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Demo-only secret, mirrors backend/app/core/config.py's jwt_secret_key.
# Must be overridden via env var before any real deployment.
JWT_SECRET=dev-only-secret-do-not-use-in-production
JWT_ALGO=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# Outbound email (mirrors backend/app/core/config.py's SMTP settings).
# Unset by default -- "Email" features (login OTP, password reset, and
# every document's Email button) fail with a clear message instead of
# silently pretending to send. Set these to a real SMTP account before
# using them. One shared mailbox for the whole install, not per-company.
# SMTP_USE_TLS=true means a plain connection upgraded with STARTTLS
# (port 587), required -- the send fails if the server will not upgrade,
# matching the Python backend's unconditional starttls(). false means no
# TLS at all. Implicit TLS-on-connect (SMTPS, port 465) is not supported
# by either backend. See DEV_SETUP.md.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=
SMTP_FROM_NAME="Web Master Consultancy"

# File uploads (mirrors backend/app/core/config.py's uploads_dir).
UPLOADS_DIR=/app/uploads

# The React dev server runs on a different port (demo-only CORS, mirrors
# backend/app/main.py).
FRONTEND_URL=http://localhost:5173
