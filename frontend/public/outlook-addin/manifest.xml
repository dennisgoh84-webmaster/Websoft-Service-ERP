<?xml version="1.0" encoding="UTF-8"?>
<!--
  Outlook Add-in manifest for the Incident Module (docs/outlook-addin.md).
  Do not upload this file as it is: download it from Maintenance ->
  Outlook Add-in, which fills in this server's HTTPS address everywhere
  the add-in's files are referenced (Outlook will not load a plain-HTTP
  add-in).

  This is the classic XML manifest, which every Outlook client (desktop,
  web, mobile) still supports.
-->
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
  xsi:type="MailApp">

  <Id>3f6a7b2c-8e1d-4b5a-9c3e-1a2b3c4d5e6f</Id>
  <Version>1.1.0.0</Version>
  <ProviderName>Web Master Consultancy Pte Ltd</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Websoft Incidents" />
  <Description DefaultValue="Log this email as an Incident, or convert it straight to a Job Order." />
  <IconUrl DefaultValue="https://{{HOST}}/outlook-addin/assets/icon-32.png" />
  <HighResIconUrl DefaultValue="https://{{HOST}}/outlook-addin/assets/icon-80.png" />
  <SupportUrl DefaultValue="https://{{HOST}}/" />

  <AppDomains>
    <AppDomain>https://{{HOST}}</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Mailbox" />
  </Hosts>

  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.5" />
    </Sets>
  </Requirements>

  <!-- Read-only task pane: reads the open message's sender/subject/body
       (Office.context.mailbox.item) to log it, never sends mail itself. -->
  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://{{HOST}}/outlook-addin/taskpane.html" />
        <RequestedHeight>450</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>

  <Permissions>ReadItem</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read" />
  </Rule>
  <DisableEntityHighlighting>false</DisableEntityHighlighting>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Requirements>
      <bt:Sets DefaultMinVersion="1.5">
        <bt:Set Name="Mailbox" />
      </bt:Sets>
    </Requirements>
    <Hosts>
      <Host xsi:type="MailHost">
        <DesktopFormFactor>
          <FunctionFile resid="Commands.Url" />
          <ExtensionPoint xsi:type="MessageReadCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="WebsoftIncidentGroup">
                <Label resid="Group.Label" />
                <Control xsi:type="Button" id="WebsoftIncidentButton">
                  <Label resid="TaskpaneButton.Label" />
                  <Supertip>
                    <Title resid="TaskpaneButton.Label" />
                    <Description resid="TaskpaneButton.Tooltip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16" />
                    <bt:Image size="32" resid="Icon.32x32" />
                    <bt:Image size="80" resid="Icon.80x80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="Taskpane.Url" />
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="https://{{HOST}}/outlook-addin/assets/icon-16.png" />
        <bt:Image id="Icon.32x32" DefaultValue="https://{{HOST}}/outlook-addin/assets/icon-32.png" />
        <bt:Image id="Icon.80x80" DefaultValue="https://{{HOST}}/outlook-addin/assets/icon-80.png" />
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Commands.Url" DefaultValue="https://{{HOST}}/outlook-addin/taskpane.html" />
        <bt:Url id="Taskpane.Url" DefaultValue="https://{{HOST}}/outlook-addin/taskpane.html" />
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="Group.Label" DefaultValue="Websoft Incidents" />
        <bt:String id="TaskpaneButton.Label" DefaultValue="Log Incident" />
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="TaskpaneButton.Tooltip" DefaultValue="Convert this email to an Incident, or straight to a Job Order." />
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
