# Copy to .env and fill in real values before `docker compose up`.
# .env is gitignored — never commit real secrets.

# A strong random password for the Central Command Postgres user.
CC_POSTGRES_PASSWORD=

# A long random string — generate with e.g. `openssl rand -hex 32`.
# Never reuse the "dev-only-secret" default from backend/app/core/config.py.
CC_JWT_SECRET_KEY=

# Which host port the CC frontend (nginx) listens on. Default 8080.
CC_HTTP_PORT=8080
