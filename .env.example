# Copy to .env at the repository root and fill in real values before
# `docker compose up`. deploy/install.sh writes this file for you on a
# fresh server. .env is gitignored -- never commit real secrets.

# A strong random password for the Postgres user this stack creates.
POSTGRES_PASSWORD=

# A long random string -- generate with `openssl rand -hex 32`.
JWT_SECRET_KEY=

# Laravel's application key -- `base64:` + `openssl rand -base64 32`.
# It encrypts the stored mail passwords (Company Setup's mailbox), so
# losing it makes those unreadable; keep it with the rest of your
# secrets.
APP_KEY=

# Which host port nginx (the frontend container) listens on. Leave as
# 80 if this server is dedicated to this app; change if it shares the
# box with something else already using 80.
HTTP_PORT=80

# Which address that port listens on. 0.0.0.0 = the whole network. Once
# HTTPS is in front (Central Command's scripts/setup-https.sh, see
# DEPLOY.md section 4), set 127.0.0.1 so plain HTTP only works from this
# server itself -- the upgrade agent uses 127.0.0.1 and keeps working.
HTTP_BIND=0.0.0.0

# The SYSTEM mailbox: login one-time codes, password resets, and portal
# invites. Leave blank and everything else still works -- a portal
# invite shows its temporary password on screen instead of emailing it.
# Customer-facing document email (Invoices, Quotations, ...) does NOT
# use this: each company sets its own mailbox under Company Setup.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Web Master Consultancy
