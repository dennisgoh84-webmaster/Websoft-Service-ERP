# Copy to .env and fill in real values before `docker compose up`.
# .env is gitignored -- never commit real secrets.

# A strong random password for the Postgres user this stack creates.
POSTGRES_PASSWORD=

# A long random string -- generate with e.g. `openssl rand -hex 32`.
# Never reuse the "dev-only-secret" default from backend/app/core/config.py.
JWT_SECRET_KEY=

# Laravel's application key -- ONLY needed if you run the PHP backend
# (`docker compose --profile php ...`; see docker-compose.yml). Generate
# with `docker compose run --rm --entrypoint php backend-php artisan
# key:generate --show`. It encrypts the per-company SMTP password in
# Company Setup, so losing it makes those unreadable; keep it with the
# rest of your secrets.
APP_KEY=

# Which host port nginx (the frontend container) listens on. Leave as
# 80 if this VPS is dedicated to this app; change if it shares the box
# with something else already using 80.
HTTP_PORT=80

# Outbound email for the "Email" button (Purchase Order, Sales
# Quotation/Invoice, Receipt/Payment Voucher, Statement of Accounts).
# One shared mailbox for the whole install. Leave all blank to leave
# Email disabled (WhatsApp and Print/Word export work regardless).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Web Master Consultancy
